# Environment Configuration for DocuForge

# Database
DATABASE_URL=postgresql://docuforge:docuforge_secret@localhost:5432/docuforge_db

# Background Queue & Cache
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=docuforge-ephemeral
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# AI Integrations
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.0-flash

# Stripe Payments & Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Application URLs & Security
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super_secure_jwt_secret_docuforge_2026
FILE_RETENTION_HOURS=1
