# ==============================================================================
# DocuForge 2.0 - Environment Configuration
# ==============================================================================

# Server Port (e.g. 7070 or 3000)
APP_PORT=7070

# MongoDB Atlas Cloud Database Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/docuforge?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=docuforge_super_secure_jwt_secret_key_2026_production

# Razorpay Payment Gateway (Optional - Can also be configured directly in UI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
